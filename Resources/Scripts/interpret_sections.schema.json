{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "meeting_title": { "type": "string", "minLength": 1, "maxLength": 40 },
    "disposition": { "type": "string", "enum": ["keep", "test"] },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "reason": { "type": "string", "minLength": 1, "maxLength": 200 },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "title": { "type": "string" },
          "timestamp": { "type": "number", "minimum": 0 },
          "capture_timestamp": { "type": "number", "minimum": 0 },
          "summary": { "type": "string" },
          "bullets": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "required": ["title", "timestamp", "capture_timestamp", "summary", "bullets"],
        "additionalProperties": false
      }
    }
  },
  "required": ["meeting_title", "disposition", "confidence", "reason", "sections"],
  "additionalProperties": false
}
