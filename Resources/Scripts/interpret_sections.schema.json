{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "title": { "type": "string" },
          "timestamp": { "type": "number", "minimum": 0 },
          "capture_timestamp": { "type": "number", "minimum": 0 },
          "summary": { "type": "string" },
          "bullets": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "required": ["title", "timestamp", "capture_timestamp", "summary", "bullets"],
        "additionalProperties": false
      }
    }
  },
  "required": ["sections"],
  "additionalProperties": false
}
